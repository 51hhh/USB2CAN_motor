vision_goal_tracker_node:
  ros__parameters:
    # realtime: 不需要 --auto-goal，直接追 /frontvehicle/ball/realtime。
    # auto_goal: 只追 /frontvehicle/auto/goal_pose。
    # auto_or_pre_goal: 有 auto_goal 时优先正式落点，否则用 pre_goal；不追 realtime。
    target_source: "auto_goal"
    realtime_topic: "/frontvehicle/ball/realtime"
    pre_goal_topic: "/frontvehicle/auto/pre_goal_pose"
    goal_topic: "/frontvehicle/auto/goal_pose"
    # 视觉目标在 frontvehicle_world 下，必须配同一坐标系的 ZED odom。
    odom_topic: "/frontvehicle/vision/zed_odom"
    cmd_topic: "/vision/cmd_vel"

    publish_rate: 50.0
    goal_timeout: 1.5
    odom_timeout: 0.8
    require_odom: true

    # 二次保护：auto_goal 只收 7m 内；realtime 允许超过 5m，但丢弃明显异常远点。
    max_goal_distance: 8.0
    max_realtime_distance: 14.0
    max_realtime_abs_y: 5.0
    min_realtime_x: 0.0
    auto_goal_realtime_lockout: 6.0
    auto_goal_hold_time: 0.6
    auto_goal_correction_jump_gate: 0.6
    auto_goal_correction_slow_sec: 0.25
    auto_goal_correction_speed_scale: 0.45
    pre_goal_hold_time: 2.0
    goal_tolerance: 0.10
    stop_forward_distance: 0.30
    lateral_overshoot_distance: 0.20
    lateral_overshoot_deadband: 0.03

    # 视觉坐标默认约定: x=前方, y=左侧。
    # 底盘速度约定: linear.y=前进, linear.x=右移。
    kp_forward: 4.2
    kp_lateral: 1.9
    max_forward_velocity: 7.5
    max_lateral_velocity: 2.4
    max_far_lateral_velocity: 1.0
    far_lateral_distance: 2.5
    max_backward_velocity: 1.0
    max_linear_accel: 18.0
    approach_slow_distance: 0.65
    max_near_forward_velocity: 2.2
    reverse_deadband: 0.2
    forward_sign: 1.0
    lateral_sign: -1.0
    use_odom_yaw: false
    yaw_hold_enabled: false
    yaw_hold_kp: 1.2
    max_yaw_velocity: 0.6
    yaw_deadband: 0.04
    yaw_sign: 1.0

    # 持球阶段实时球点通常变化很慢：只做左右对齐，不主动前进。
    # 球点平面速度超过阈值后认为已经抛出，开始前进+横向追。
    realtime_lateral_only_when_slow: false
    realtime_chase_min_speed: 0.4
    realtime_speed_alpha: 0.25
